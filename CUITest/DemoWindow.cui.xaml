            <Grid.Resources>
              <Color x:Key="WpfLabAccent">#FF14A37F</Color>
              <String x:Key="WpfLabFontFamily">Consolas</String>
              <Double x:Key="WpfLabFontSize">15</Double>
              <Style x:Key="WpfLabLiveButton" TargetType="Button" BasedOn="{StaticResource WpfLabBaseButton}">
                <Setter Property="Background" Value="{DynamicResource WpfLabAccent}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Style>
              <Style x:Key="WpfFocusScopeBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#FFD3DCE8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="true">
                    <Setter Property="BorderBrush" Value="#FF35A66F"/>
                    <Setter Property="BorderThickness" Value="2"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6*"/>
              <ColumnDefinition Width="6*"/>
              <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="wpfLabTitle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Style="{StaticResource PageHeader}"
              Text="DispatcherObject → DependencyObject → Visual → UIElement → FrameworkElement → Control · WPF retained object model"/>
            <ContentControl x:Name="wpfBindingScope" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0"
              FontFamily="{DynamicResource WpfLabFontFamily}" FontSize="{DynamicResource WpfLabFontSize}">
              <StackPanel Orientation="Vertical" Tag="FindAncestor · StackPanel">
                <TextBlock x:Name="wpfTypographyOverride" Text="Typography: inherited Consolas 15 · local size 14"
                  Foreground="{StaticResource Accent}" FontSize="14" Height="24"/>
                <TextBox x:Name="wpfTwoWayEditor" Height="28" SelectionBrush="#FF7C3AED" SelectionOpacity="0.45"
                  SelectionTextBrush="#FFFFFFFF" CaretBrush="#FF7C3AED"
                  Text="{Binding WpfFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="wpfElementMirror" Height="24" Text="{Binding Text, ElementName=wpfTwoWayEditor, Mode=OneWay}"/>
                <TextBlock x:Name="wpfSelfValue" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" Height="24" Text="RelativeSource Self"/>
                <TextBlock x:Name="wpfAncestorValue" AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StackPanel}}}" Height="24" Text="RelativeSource FindAncestor"/>
                <TextBlock x:Name="wpfFallbackValue" Height="24" Text="{Binding WpfMissing, FallbackValue='Fallback: unavailable'}"/>
                <TextBlock x:Name="wpfNullValue" Height="24" Text="{Binding WpfNullable, FallbackValue='broken', TargetNullValue='TargetNull: (none)'}"/>
                <TextBlock x:Name="wpfIndexerValue" Height="24" Text="{Binding WpfPeople[0].First, FallbackValue='No first person'}"/>
                <TextBlock x:Name="wpfKeyedIndexerValue" Height="24" Text="{Binding WpfSettings['accent.color']}"/>
                <TextBlock x:Name="wpfConvertedValue" Height="24" Text="{Binding WpfPadded, Converter=StringTrim, StringFormat='trimmed: {0}'}"/>
                <TextBlock x:Name="wpfMultiValue" Height="24">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} / {1} / {2}">
                      <Binding Path="WpfFirst"/>
                      <Binding Path="WpfLast"/>
                      <Binding Path="WpfSettings[title]"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </ContentControl>
            <StackPanel x:Name="wpfTemplateAndStyleScope" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
              <TextBlock Style="{StaticResource SectionHeader}" Text="ControlTemplate + resources + triggers"/>
              <Button x:Name="wpfTemplateButton" AutomationProperties.Name="RelativeSource TemplatedParent"
                Height="112" Template="{StaticResource WpfLabButtonTemplate}"
                Content="click · swap Control.Template on same Button" Click="HandleTemplateSwap"/>
              <Button x:Name="wpfTriggerButton" Margin="0,12,0,0" Height="38" HorizontalAlignment="Left"
                Style="{StaticResource WpfLabLiveButton}" Content="Trigger ready" Width="220"/>
              <TextBlock x:Name="wpfScopeResourceValue" Margin="0,14,0,0" Foreground="{DynamicResource WpfLabAccent}"
                Height="24" Text="local DynamicResource (green)"/>
              <StackPanel x:Name="wpfInnerResourceScope" Margin="0,12,0,0" Height="74">
                <StackPanel.Resources>
                  <Color x:Key="WpfLabAccent">#FFF0872E</Color>
                </StackPanel.Resources>
                <TextBlock x:Name="wpfInnerResourceValue" Foreground="{DynamicResource WpfLabAccent}" Height="24" Text="nested resource shadow (orange)"/>
              </StackPanel>
              <TextBlock Margin="0,12,0,0" Height="52" Text="DataTrigger + MultiDataTrigger + MultiTrigger&#xA;Enter/ExitActions run Begin/StopStoryboard"/>
            </StackPanel>
            <Grid x:Name="wpfItemsScope" Grid.Row="1" Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="176"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="ItemsPresenter + ListBoxItem + DataTemplate"/>
              <ListBox x:Name="wpfTemplateList" Grid.Row="1" DisplayMemberPath="First"
                ItemContainerStyle="{StaticResource WpfLabContainerStyle}" ItemsPanel="{StaticResource WpfLabItemsPanel}"
                ItemsSource="{Binding WpfPeople}" ItemTemplate="{StaticResource WpfLabPersonRow}"
                Template="{StaticResource WpfLabListTemplate}"/>
              <Border x:Name="wpfRouteOuter" Grid.Row="2" Margin="0,12,0,0" FocusManager.IsFocusScope="true"
                Background="#FFF7F9FC" Style="{StaticResource WpfFocusScopeBorder}"
                PreviewMouseDown="HandleRouteOuterPreview" PreviewKeyDown="HandleRouteKey" KeyDown="HandleRouteKey"
                PreviewTextInput="HandleTextOuterPreview" TextInput="HandleTextOuterBubble">
                <Border.Resources>
                  <Style TargetType="Button">
                    <Setter Property="BorderBrush" Value="#FFD3DCE8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="4,4"/>
                    <Style.Triggers>
                      <Trigger Property="IsFocused" Value="true">
                        <Setter Property="BorderBrush" Value="#FFF0872E"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="true">
                        <Setter Property="BorderBrush" Value="#FF2F6FE4"/>
                        <Setter Property="BorderThickness" Value="3"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Resources>
                <Grid Margin="8,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Focusable / IsTabStop + logical / keyboard / within state"
                    Foreground="{StaticResource Accent}" FontSize="13" Height="22"/>
                  <Grid x:Name="wpfRouteMiddle" Grid.Row="1" Margin="0,6,0,6" FocusManager.IsFocusScope="true"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"
                    Height="62" Background="#FFEAF2FF" PreviewMouseDown="HandleRouteMiddlePreview" MouseDown="HandleRouteMiddleBubble">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="wpfRouteSource" Grid.Column="0" Margin="6,13,4,13" Content="Route / Focus A"
                      PreviewMouseDown="HandleRouteSourcePreview" MouseDown="HandleRouteSourceBubble"
                      PreviewKeyDown="HandleRouteKey" KeyDown="HandleRouteKey"
                      GotMouseCapture="HandleRouteCaptureChanged" LostMouseCapture="HandleRouteCaptureChanged"
                      PreviewGotKeyboardFocus="HandleRoutePreviewGotKeyboardFocus" GotKeyboardFocus="HandleRouteGotKeyboardFocus"
                      PreviewLostKeyboardFocus="HandleRoutePreviewLostKeyboardFocus" LostKeyboardFocus="HandleRouteLostKeyboardFocus" GotFocus="HandleRouteFocus"/>
                    <Button x:Name="wpfFocusPeerB" Grid.Column="1" Margin="4,13" Focusable="true" IsTabStop="false" Content="B · no Tab"/>
                    <Button x:Name="wpfFocusPeerC" Grid.Column="2" Margin="4,13" Content="Focus C"/>
                    <Button x:Name="wpfNoFocusPeer" Grid.Column="3" Margin="4,13" Focusable="false" IsTabStop="true" Content="Blocked"/>
                  </Grid>
                  <TextBox x:Name="wpfTextInputSource" Grid.Row="2" Height="27"
                    Text="输入文本：PreviewTextInput → behavior → TextInput"
                    PreviewTextInput="HandleTextSourcePreview" TextInput="HandleTextSourceBubble"/>
                  <TextBlock x:Name="wpfRouteTrace" Grid.Row="3" Height="22"
                    Text="T outer → middle → source · B source(H) → outer(too)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock x:Name="wpfInputStats" Grid.Row="4" Height="22"
                    Text="raw 0 · capture 0/0 · focus 0 · handled skip 0" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </Grid>
              </Border>
            </Grid>
            <Grid x:Name="wpfHierarchyScope" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
              <Grid.CommandBindings>
                <CommandBinding Command="Demo.Wpf.Probe" CanExecute="HandleLocalCommandCanExecute" Executed="HandleLocalCommandExecuted"/>
              </Grid.CommandBindings>
              <Grid.InputBindings>
                <KeyBinding Command="Demo.Wpf.Probe" Key="P" Modifiers="Control,Shift" CommandParameter="local-keybinding" CommandTarget="{x:Reference wpfHierarchyScope}"/>
                <MouseBinding Command="Demo.Wpf.Probe" Gesture="Alt+RightClick" CommandParameter="local-mousebinding" CommandTarget="{x:Reference wpfHierarchyScope}"/>
              </Grid.InputBindings>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="345"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="wpfHierarchyChain" Grid.Column="0" Margin="0,5,12,0"
                Foreground="{StaticResource TextMuted}" Height="24"
                Text="FocusScope · logical/keyboard focus · Tab/方向策略 · RoutedCommand"/>
              <Button x:Name="wpfDispatcherProbe" Grid.Column="1" Command="Demo.Wpf.Probe"
                CommandParameter="command-button" CommandTarget="{x:Reference wpfHierarchyScope}"
                Height="32" Click="HandleDispatcherProbe" Content="_Run Dispatcher/命令探针" Padding="6,4"/>
              <TextBlock x:Name="wpfDispatcherResult" Grid.Column="2" Margin="14,5,0,0"
                Height="24" Text="Ready · foreign-thread writes must throw"/>
            </Grid>
          </Grid>
        </Border>
      </TabItem>
      <TabItem Header="TextComposition/IME">
        <Border Margin="4,8,4,4" Style="{StaticResource SurfacePanel}">
          <Grid x:Name="textCompositionLabSurface"
            PreviewTextInputStart="HandleCompositionPreviewStart" TextInputStart="HandleCompositionStart"
            PreviewTextInputUpdate="HandleCompositionPreviewUpdate" TextInputUpdate="HandleCompositionUpdate"
            PreviewTextInput="HandleCompositionPreviewCommit" TextInput="HandleCompositionCommit">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="248"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PageHeader}"
              Text="TextCompositionManager · WM_CHAR / WM_UNICHAR / IMM32 → Start / Update / TextInput"/>
            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Padding="12,10"
              Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="真实系统键盘 / IME 输入客户端"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,12" Text="TextBox · 单行 · 完整 UTF-16 一次提交"/>
                <TextBox x:Name="compositionTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Height="30" Text="TextBox: "/>
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,12" Text="RichTextBox · 多行 / Undo / IsReadOnly 规则"/>
                <RichTextBox x:Name="compositionRichTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Height="70" Text="RichTextBox:&#xD;&#xA;"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,12,10" Text="PasswordBox · 提交与日志均不回显正文"/>
                <PasswordBox x:Name="compositionPasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="30" Password=""/>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DescriptionText}"
                  Text="其他客户端：NumericUpDown / ItemsControl / NativeSurface 共用同一输入链。"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="12,10"
              Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="76"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="确定性事务注入（无需安装特定 IME）"/>
                <WrapPanel Grid.Row="1" ItemHeight="32">
                  <Button x:Name="compositionStartProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="Start" Width="76"/>
                  <Button x:Name="compositionUpdateProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="Update: ni" Width="96"/>
                  <Button x:Name="compositionCommitProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="Commit: 你😀" Width="112"/>
                  <Button x:Name="compositionCancelProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="Cancel" Width="76"/>
                  <Button x:Name="compositionSurrogateProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="WM_CHAR 😀" Width="132"/>
                  <Button x:Name="compositionUnicharProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="WM_UNICHAR 🙂" Width="136"/>
                  <Button x:Name="compositionFocusProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="组合中切换焦点" Width="136"/>
                  <Button x:Name="compositionPreviewHandledProbe" Margin="0,0,8,6" Height="32" Click="HandleTextCompositionProbe" Content="Preview Handled: off" Width="176"/>
                  <Button x:Name="compositionResetProbe" Margin="0,0,0,6" Height="32" Click="HandleTextCompositionProbe" Content="Reset" Width="72"/>
                </WrapPanel>
                <TextBlock x:Name="compositionState" Grid.Row="2" Margin="0,8,0,0" Height="36" Text="Idle · id 0 · caret -1 · source ∅"/>
                <TextBlock x:Name="compositionStats" Grid.Row="3" Height="36" Text="native 0 · start/update/commit/cancel 0/0/0/0 · applied 0 · echo 0"/>
              </Grid>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12,8"
              Background="#FF101820" BorderBrush="#FF324356" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Foreground="#FF8DDCC8" FontSize="14" Height="24"
                  Text="同一 CompositionId 的 tunnel → source behavior → bubble 时间线"/>
                <TextBlock x:Name="compositionTrace" Grid.Row="1" Margin="0,6,0,0" Foreground="#FFD6E2F0"
                  FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="等待真实 IME 或确定性探针…"/>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>
      <TabItem Header="Presentation/渲染">
        <Border Margin="4,8,4,4" Style="{StaticResource SurfacePanel}">
          <Grid x:Name="presentationLabSurface">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="8*"/>
              <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PageHeader}"
              Text="XAML visual tree → retained PresentationScene → PresentationRenderHost → PlatformWindowHost (HWND)"/>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,18,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <NativeSurface x:Name="presentationProbeSurface" Grid.Row="0" BehaviorKey="PresentationProbe"
                PlaceholderText="PresentationProbe behavior 未注册"
                AutomationProperties.Name="Presentation render host dirty-region probe"/>
              <!-- Canvas.Left is intentional on this separate geometry track: moving
                   the node exercises geometry-only invalidation without covering the
                   interactive NativeSurface above it. -->
              <Canvas Grid.Row="1" Margin="0,10,0,0" Height="42" Background="#00000000">
                <TextBlock x:Name="presentationTopologyTile" Canvas.Left="12" Canvas.Top="0"
                  Background="{StaticResource Accent}" Foreground="{StaticResource OnAccent}"
                  Height="42" Text="retained node · ZIndex 5" Width="178" ZIndex="5"/>
              </Canvas>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="1">
              <TextBlock Style="{StaticResource SectionHeader}" Text="Retained scene snapshot"/>
              <TextBlock Margin="0,0,0,12" Style="{StaticResource DescriptionText}"
                Text="结构、内容、几何、仅合成拥有独立 revision。VisualChildren / Visibility / ZIndex 才重建结构；布局、Transform、Clip 只使节点几何快照失效。"/>
              <TextBlock Style="{StaticResource SectionHeader}" Text="Damage replay 与内容重录"/>
              <TextBlock Margin="0,0,0,12" Style="{StaticResource DescriptionText}"
                Text="同一 segment 清除局部区域后，区域内节点 replay 使用不可变 command list；只有内容或几何变化才重录，composition-only 和 damage 帧直接复用。"/>
              <TextBlock Style="{StaticResource SectionHeader}" Text="资源与设备边界"/>
              <TextBlock Style="{StaticResource DescriptionText}"
                Text="显式 frame transaction 原子管理 primary / scene / overlay。设备恢复提升 resource generation，并统一清空命令与 behavior 设备资源。"/>
            </StackPanel>
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" Height="40" ItemHeight="34">
                <Button x:Name="presentationRegionButton" Margin="0,0,10,0" Height="34" Click="HandlePresentationRegion" Content="内容 Pulse" Width="130"/>
                <Button x:Name="presentationGeometryButton" Margin="0,0,10,0" Height="34" Click="HandlePresentationGeometry" Content="几何移动" Width="130"/>
                <Button x:Name="presentationCompositionButton" Margin="0,0,10,0" Height="34" Click="HandlePresentationComposition" Content="仅合成提交" Width="130"/>
                <Button x:Name="presentationFullButton" Margin="0,0,10,0" Height="34" Click="HandlePresentationFullFrame" Content="完整帧 replay" Width="130"/>
                <Button x:Name="presentationTopologyButton" Margin="0,0,10,0" Height="34" Click="HandlePresentationTopology" Content="切换结构节点" Width="130"/>
                <Button x:Name="presentationDeviceLossButton" Height="34" Click="HandlePresentationDeviceLoss" Content="注入设备丢失" Width="130"/>
              </WrapPanel>
              <TextBlock x:Name="presentationStatus" Grid.Column="1" Margin="14,4,0,0"
                Foreground="{StaticResource TextMuted}" Text="Ready · four independent update lanes"/>
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
              Style="{StaticResource DescriptionText}"
              Text="依次触发内容重录、几何重录、仅合成复用、完整 replay、结构重建与设备恢复；左侧显示事务、generation 和命令命中统计。类型、属性、事件仍全部由 XAML 定义。"/>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
    <ContextMenu x:Name="systemContextMenu" DesignId="608" Grid.Row="3">
      <ContextMenu.Items>
        <MenuItem Header="新建项目" Command="Demo.System.NewProject" CommandParameter="context-new"/>
        <MenuItem Header="刷新视图" Command="Demo.System.Refresh" CommandParameter="context-refresh" CommandTarget="{x:Reference mainMenu}" InputGestureText="F5"/>
        <Separator/>
        <MenuItem Header="更多">
          <MenuItem.Items>
            <MenuItem Header="复制信息" Command="Demo.System.CopyInfo" CommandParameter="context-copy" CommandTarget="{x:Reference systemSurface}"/>
            <MenuItem Header="关于此页" Command="Demo.System.About" CommandParameter="context-about"/>
          </MenuItem.Items>
        </MenuItem>
      </ContextMenu.Items>
    </ContextMenu>
    <StatusBar x:Name="mainStatusBar" DesignId="900" Grid.Row="4"
               ItemsSource="{StaticResource DemoStatusEntries}"
               DisplayMemberPath="Text"/>
  </Grid>
</Window>
