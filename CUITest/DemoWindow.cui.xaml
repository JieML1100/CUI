<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="urn:cui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="urn:cui:designer" xmlns:test="urn:cui:test" x:Name="CuiXamlDemo" Title="CUI XAML Component Gallery" Width="1400" Height="800" Background="#FFE8EEF6" Foreground="#FF172033" Closing="HandleClosing" ContentRendered="HandleContentRendered" PreviewExecuted="HandleCommandPreviewExecuted">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/DemoTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="Accent">#FF2F6FE4</Color>
      <Color x:Key="Surface">#FFFFFFFF</Color>
      <Color x:Key="SurfaceSoft">#FFF7F9FC</Color>
      <Color x:Key="Border">#FFD3DCE8</Color>
      <Color x:Key="ContainerSurface">#FFF2F6FB</Color>
      <Color x:Key="ContainerBorder">#FF9FB2CA</Color>
      <Color x:Key="TextPrimary">#FF172033</Color>
      <Color x:Key="TextMuted">#FF748399</Color>
      <Color x:Key="OnAccent">#FFFFFFFF</Color>
      <Color x:Key="Success">#FF15966A</Color>
      <BitmapImage x:Key="DemoImage" UriSource="Assets/nav-overview.svg"/>
      <LinearGradientBrush x:Key="HeaderForeground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2F6FE4" Offset="0"/>
        <GradientStop Color="#FF14A37F" Offset="1"/>
      </LinearGradientBrush>
      <PathGeometry x:Key="GradientLabelClip" FillRule="Nonzero">
        <PathFigure StartPoint="12,0" IsClosed="true">
          <LineSegment Point="428,0"/>
          <ArcSegment Point="440,12" Size="12,12" SweepDirection="Clockwise"/>
          <LineSegment Point="440,22"/>
          <ArcSegment Point="428,34" Size="12,12" SweepDirection="Clockwise"/>
          <LineSegment Point="12,34"/>
          <ArcSegment Point="0,22" Size="12,12" SweepDirection="Clockwise"/>
          <LineSegment Point="0,12"/>
          <ArcSegment Point="12,0" Size="12,12" SweepDirection="Clockwise"/>
        </PathFigure>
        <Geometry.Transform>
          <ScaleTransform ScaleX="0.99000001" ScaleY="0.939999998" CenterX="220" CenterY="17"/>
        </Geometry.Transform>
      </PathGeometry>
      <TransformGroup x:Key="GradientLabelTransform">
        <RotateTransform Angle="-2"/>
        <ScaleTransform ScaleX="1.01999998" ScaleY="1.01999998"/>
      </TransformGroup>
      <DataType x:Key="DemoChoice">
        <DataType.Properties>
          <Property Path="Id" Kind="Int"/>
          <Property Path="Text" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <DataList x:Key="BasicChoices" ItemType="DemoChoice">
        <DataRecord Id="1" Text="AOT XAML"/>
        <DataRecord Id="2" Text="声明式数据资源"/>
        <DataRecord Id="3" Text="NativeSurface 扩展"/>
      </DataList>
      <DataType x:Key="DemoStatusEntry">
        <DataType.Properties>
          <Property Path="Text" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <DataList x:Key="DemoStatusEntries" ItemType="DemoStatusEntry">
        <DataRecord Text="XAML ready"/>
        <DataRecord Text="DemoWindow.cui.xaml"/>
      </DataList>
      <DataType x:Key="DemoTask">
        <DataType.Properties>
          <Property Path="Id" Kind="Int"/>
          <Property Path="Text" Kind="String"/>
          <Property Path="Category" Kind="String"/>
          <Property Path="State" Kind="Int"/>
          <Property Path="Active" Kind="Bool"/>
        </DataType.Properties>
      </DataType>
      <DataList x:Key="DemoTasks" ItemType="DemoTask">
        <DataRecord Id="1" Text="全部任务" Category="概览" State="12" Active="false"/>
        <DataRecord Id="2" Text="今天" Category="待处理" State="4" Active="true"/>
        <DataRecord Id="3" Text="进行中" Category="待处理" State="6" Active="true"/>
        <DataRecord Id="4" Text="已完成" Category="归档" State="2" Active="true"/>
      </DataList>
      <CollectionViewSource x:Key="ActiveDemoTasks" Source="{StaticResource DemoTasks}">
        <CollectionViewSource.GroupDescriptions>
          <GroupDescription PropertyName="Category"/>
        </CollectionViewSource.GroupDescriptions>
        <CollectionViewSource.AggregateDescriptions>
          <AggregateDescription Name="TotalState" PropertyName="State" Function="Sum"/>
        </CollectionViewSource.AggregateDescriptions>
        <CollectionViewSource.FilterDescriptions>
          <FilterDescription PropertyName="Active" Value="true"/>
        </CollectionViewSource.FilterDescriptions>
        <CollectionViewSource.SortDescriptions>
          <SortDescription PropertyName="State" Direction="Descending"/>
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
      <DataTemplate x:Key="DemoTaskRow" DataType="DemoTask">
        <StackPanel Orientation="Horizontal" Height="32">
          <TextBlock Text="{Binding Text}" Width="138" Height="24"/>
          <TextBlock Text="{Binding State}" Foreground="{StaticResource TextMuted}" Width="36" Height="24"/>
        </StackPanel>
      </DataTemplate>
      <DataType x:Key="AnalyticsRow">
        <DataType.Properties>
          <Property Path="Customer" Kind="String"/>
          <Property Path="Region" Kind="String"/>
          <Property Path="Stage" Kind="String"/>
          <Property Path="Amount" Kind="String"/>
          <Property Path="Margin" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <DataList x:Key="AnalyticsRows" ItemType="AnalyticsRow">
        <DataRecord Customer="上海云舟" Region="华东" Stage="已成交" Amount="312.4" Margin="31%"/>
        <DataRecord Customer="杭州数擎" Region="华东" Stage="合同中" Amount="228.6" Margin="28%"/>
        <DataRecord Customer="深圳星河" Region="华南" Stage="已成交" Amount="276.8" Margin="29%"/>
        <DataRecord Customer="广州远航" Region="华南" Stage="跟进中" Amount="162.5" Margin="25%"/>
      </DataList>
      <DataTemplate x:Key="AnalyticsRowTemplate" DataType="AnalyticsRow">
        <StackPanel Orientation="Horizontal" Height="34">
          <TextBlock Text="{Binding Customer}" Width="138" Height="24"/>
          <TextBlock Text="{Binding Region}" Width="62" Height="24"/>
          <TextBlock Text="{Binding Stage}" Width="76" Height="24"/>
          <TextBlock Text="{Binding Amount}" Width="86" Height="24"/>
          <TextBlock Text="{Binding Margin}" Foreground="{StaticResource Success}" Width="56" Height="24"/>
        </StackPanel>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="MainToolBarItemsPanel">
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
      <DataType x:Key="DemoListEntry">
        <DataType.Properties>
          <Property Path="Name" Kind="String"/>
          <Property Path="State" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <DataTemplate x:Key="DemoListViewRow" DataType="DemoListEntry">
        <StackPanel Orientation="Horizontal" Height="34">
          <TextBlock Text="{Binding Name}" Width="238" Height="24"/>
          <TextBlock Text="{Binding State}" Foreground="{StaticResource TextMuted}" Width="110" Height="24"/>
        </StackPanel>
      </DataTemplate>
      <ControlTemplate x:Key="DemoListViewItemTemplate" TargetType="ListViewItem">
        <Border Padding="6,2" Background="{TemplateBinding Background}"
          BorderBrush="{StaticResource Border}" BorderThickness="1">
          <ContentPresenter ContentSource="Content"/>
        </Border>
      </ControlTemplate>
      <Style TargetType="ListViewItem" x:Key="DemoListViewContainer">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template"
          Value="{StaticResource DemoListViewItemTemplate}"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="true">
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="true">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="DemoTaskGroupHeader" DataType="CollectionViewGroup">
        <StackPanel Orientation="Horizontal" Height="24">
          <TextBlock Text="{Binding Key}" Foreground="{StaticResource Accent}" FontSize="13" Height="24"/>
          <TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource TextMuted}" FontSize="12" Height="24"/>
          <TextBlock Text="{Binding Aggregates.TotalState}" Foreground="{StaticResource TextMuted}" FontSize="12" Height="24"/>
        </StackPanel>
      </DataTemplate>
      <DataType x:Key="DemoFolder">
        <DataType.Properties>
          <Property Path="Name" Kind="String"/>
          <Property Path="Children" Kind="Object" ObjectType="BindingList" ItemType="DemoFile"/>
        </DataType.Properties>
      </DataType>
      <DataType x:Key="DemoFile">
        <DataType.Properties>
          <Property Path="Name" Kind="String"/>
          <Property Path="Kind" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <HierarchicalDataTemplate DataType="DemoFolder" ItemsSource="{Binding Children}">
        <!-- Let TreeViewItem own the row height. Fixed TextBlock heights keep
             their text layout at the top and visually separate it from the
             vertically centered expander glyph. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x25A3;" Foreground="{StaticResource Accent}"
            Width="22" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </StackPanel>
      </HierarchicalDataTemplate>
      <DataTemplate DataType="DemoFile">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x2022;" Foreground="{StaticResource TextMuted}"
            Width="22" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" Width="108"
            VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextMuted}"
            Width="48" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>
      <ComponentDefinition x:Key="test:FeatureCard" BaseType="Canvas" DisplayName="WPF feature card">
        <ComponentDefinition.Properties>
          <ComponentProperty Name="Caption" Type="String" Default="FeatureCard" Category="Content"/>
          <ComponentProperty Name="State" Type="String" Default="Created" ReadOnly="true" Category="Runtime"/>
          <ComponentProperty Name="IsActive" Type="Bool" Default="false" Category="State"/>
          <ComponentProperty Name="AccentColor" Type="Color" Default="#FF2F6FE4" Category="Appearance" AffectsRender="true"/>
          <ComponentProperty Name="ContentPadding" Type="Thickness" Default="12" Category="Layout" AffectsMeasure="true"/>
        </ComponentDefinition.Properties>
        <ComponentDefinition.ContentProperties>
          <ComponentContentProperty Name="Content" Cardinality="Single" Default="true"/>
          <ComponentContentProperty Name="Actions" Cardinality="Multiple"/>
        </ComponentDefinition.ContentProperties>
        <ComponentDefinition.Events>
          <ComponentEvent Name="Invoked" DisplayName="Invoke feature card" Category="Action" Default="true" RoutingStrategy="Bubble"/>
          <ComponentEvent Name="Pulse" DisplayName="Start feature pulse" Category="Action" RoutingStrategy="Direct"/>
          <ComponentEvent Name="StopPulse" DisplayName="Stop feature pulse" Category="Action" RoutingStrategy="Direct"/>
        </ComponentDefinition.Events>
        <ComponentDefinition.Template>
          <Border x:Name="PART_Root" Padding="{TemplateBinding ContentPadding}" Background="#FFF7F9FC" BorderBrush="#FFD3DCE8" BorderThickness="1" Canvas.Left="2">
            <Border.InputBindings>
              <KeyBinding Command="Demo.Component.ClassProbe" Gesture="Ctrl+F10"
                CommandParameter="template-native-input"
                CommandTarget="{x:Reference PART_Root}"/>
            </Border.InputBindings>
            <Border.Triggers>
              <EventTrigger RoutedEvent="Pulse">
                <BeginStoryboard x:Name="FeaturePulseClock">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Root" Storyboard.TargetProperty="(Canvas.Left)" Duration="0:0:0.400">
                      <LinearDoubleKeyFrame KeyTime="0:0:0.160" Value="18"/>
                      <SplineDoubleKeyFrame KeyTime="0:0:0.400" Value="24" KeySpline="0.25,0.1 0.25,1"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="StopPulse">
                <StopStoryboard BeginStoryboardName="FeaturePulseClock"/>
              </EventTrigger>
            </Border.Triggers>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="InteractionStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition From="Normal" To="Active" GeneratedDuration="0:0:0.220">
                    <VisualTransition.GeneratedEasingFunction>
                      <QuadraticEase EasingMode="EaseInOut"/>
                    </VisualTransition.GeneratedEasingFunction>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal">
                  <VisualState.Setters>
                    <Setter TargetName="PART_Root" Property="Background" Value="#FFF7F9FC"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Active">
                  <VisualState.StateTriggers>
                    <StateTrigger Property="IsActive" Value="true"/>
                  </VisualState.StateTriggers>
                  <VisualState.Setters>
                    <Setter TargetName="PART_Root" Property="Background" Value="#FFEAF2FF"/>
                    <Setter TargetName="PART_Root" Property="Canvas.Left" Value="12"/>
                    <Setter TargetName="PART_State" Property="Foreground" Value="{StaticResource Success}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Invoked">
                  <VisualState.StateTriggers>
                    <EventTrigger Event="Invoked"/>
                  </VisualState.StateTriggers>
                  <VisualState.Setters>
                    <Setter TargetName="PART_Root" Property="Background" Value="#FFDDE9FF"/>
                    <Setter TargetName="PART_Caption" Property="Foreground" Value="{StaticResource Accent}"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel>
              <TextBlock x:Name="PART_Caption" Text="{TemplateBinding Caption}" Foreground="{TemplateBinding AccentColor}" FontSize="16" Height="25"/>
              <TextBlock x:Name="PART_State" Text="{TemplateBinding State}" Foreground="{StaticResource TextMuted}" FontSize="12" Height="22"/>
              <StackPanel x:Name="PART_Content" ComponentSlot.Presents="Content"/>
              <Button x:Name="PART_Invoke" Content="Raise XAML Invoked" Height="28" Width="170" Click="{RaiseEvent Invoked}"/>
              <StackPanel x:Name="PART_Actions" ComponentSlot.Presents="Actions" Orientation="Horizontal" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </ComponentDefinition.Template>
      </ComponentDefinition>
      <GroupStyle x:Key="DemoTaskGroups"
        HeaderTemplate="{StaticResource DemoTaskGroupHeader}"/>
      <ItemsPanelTemplate x:Key="DemoTaskItemsPanel">
        <VirtualizingStackPanel ItemHeight="36" CacheLength="1"/>
      </ItemsPanelTemplate>
      <Style TargetType="ListBoxItem" x:Key="DemoTaskContainer">
        <Setter Property="Padding" Value="6,2"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="true">
            <Setter Property="Background" Value="{StaticResource SurfaceSoft}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="true">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataType x:Key="WpfLabPerson">
        <DataType.Properties>
          <Property Path="First" Kind="String"/>
          <Property Path="Last" Kind="String"/>
          <Property Path="Role" Kind="String"/>
        </DataType.Properties>
      </DataType>
      <DataTemplate x:Key="WpfLabPersonRow" DataType="WpfLabPerson">
        <StackPanel Orientation="Horizontal" Height="26">
          <TextBlock Text="{Binding First}" Width="70" Height="24"/>
          <TextBlock Text="{Binding Last}" Width="82" Height="24"/>
          <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextMuted}" Width="66" Height="24"/>
        </StackPanel>
      </DataTemplate>
      <ControlTemplate x:Key="WpfLabButtonTemplate" TargetType="Button">
        <Border x:Name="wpfButtonChrome" Padding="8" Background="#FFF7F9FC" BorderBrush="#FFD3DCE8" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="wpfTemplatedParentValue" Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Accent}" Height="24"/>
            <TextBlock x:Name="wpfTreeRelationValue" Text="template root: VisualParent=Button · LogicalParent=∅ · TemplatedParent=Button" Foreground="{StaticResource TextMuted}" FontSize="11" Height="20"/>
            <ContentPresenter x:Name="wpfButtonContentPresenter" ContentSource="Content"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
      <ControlTemplate x:Key="WpfLabButtonTemplateAlternate" TargetType="Button">
        <Border x:Name="wpfAlternateButtonChrome" Padding="8" Background="#FFE8F5EE" BorderBrush="#FF15966A" BorderThickness="2">
          <StackPanel>
            <TextBlock x:Name="wpfAlternateTemplateState" Text="ApplyTemplate · alternate tree" Foreground="{StaticResource Success}" Height="24"/>
            <TextBlock Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource TextMuted}" FontSize="11" Height="20"/>
            <ContentPresenter x:Name="wpfAlternateContentPresenter" ContentSource="Content"/>
          </StackPanel>
        </Border>
      </ControlTemplate>
      <ItemsPanelTemplate x:Key="WpfLabItemsPanel">
        <VirtualizingStackPanel ItemHeight="30" CacheLength="0.5"/>
      </ItemsPanelTemplate>
      <ControlTemplate x:Key="WpfLabListTemplate" TargetType="ListBox">
        <ScrollViewer x:Name="wpfListScrollHost" VerticalScrollBarVisibility="Visible">
          <ItemsPresenter x:Name="wpfItemsPresenter"/>
        </ScrollViewer>
      </ControlTemplate>
      <ControlTemplate x:Key="WpfLabListItemTemplate" TargetType="ListBoxItem">
        <Border x:Name="wpfItemChrome" Padding="{TemplateBinding Padding}" Background="#00000000" BorderBrush="#FFD3DCE8" BorderThickness="1">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
              <VisualState x:Name="Unselected"/>
              <VisualState x:Name="Selected">
                <VisualState.StateTriggers>
                  <StateTrigger Property="IsSelected" Value="true"/>
                </VisualState.StateTriggers>
                <VisualState.Setters>
                  <Setter TargetName="wpfItemChrome" Property="Background" Value="#FFDDE9FF"/>
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <ContentPresenter x:Name="wpfItemContentPresenter" ContentSource="Content"/>
        </Border>
      </ControlTemplate>
      <Style x:Key="WpfLabContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template" Value="{StaticResource WpfLabListItemTemplate}"/>
      </Style>
      <Color x:Key="WpfLabAccent">#FF2F6FE4</Color>
      <Style x:Key="WpfLabBaseButton" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="IsDefault" Value="false"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding WpfStatus}" Value="Ready">
            <Setter Property="FontSize" Value="14"/>
            <DataTrigger.EnterActions>
              <BeginStoryboard x:Name="WpfReadyPulse">
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="FontSize" From="14" To="18" Duration="0:0:0.400"/>
                </Storyboard>
              </BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
              <StopStoryboard BeginStoryboardName="WpfReadyPulse"/>
            </DataTrigger.ExitActions>
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding WpfStatus}" Value="Ready"/>
              <Condition Binding="{Binding WpfIsAdmin}" Value="true"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="IsDefault" Value="true"/>
          </MultiDataTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="Content" Value="Trigger ready"/>
              <Condition Property="IsDefault" Value="true"/>
            </MultiTrigger.Conditions>
            <Setter Property="BorderThickness" Value="4"/>
          </MultiTrigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="Border" x:Key="SurfacePanel">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="ClipToBounds" Value="true"/>
        <Setter Property="Padding" Kind="Thickness" Value="10"/>
      </Style>
      <Style TargetType="Border" x:Key="ContainerFrame">
        <Setter Property="Background" Value="{StaticResource ContainerSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ContainerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="true"/>
        <Setter Property="Padding" Kind="Thickness" Value="8"/>
      </Style>
      <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="MutedLabel">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="GradientHeader">
        <Setter Property="Foreground" Value="{StaticResource HeaderForeground}"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="PageHeader">
        <Setter Property="Foreground" Value="{StaticResource HeaderForeground}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Kind="Thickness" Value="0,0,0,12"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="SectionHeader">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Kind="Thickness" Value="0,0,0,8"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="DescriptionText">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style TargetType="Image" x:Key="ResourceImage">
        <Setter Property="Source" Value="{StaticResource DemoImage}"/>
      </Style>
      <Style TargetType="TextBlock" x:Key="ResourceGeometryVisual">
        <Setter Property="Clip" Value="{StaticResource GradientLabelClip}"/>
        <Setter Property="RenderTransform" Value="{StaticResource GradientLabelTransform}"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="Demo.File.Open" PreviewCanExecute="HandleCommandPreviewCanExecute" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.File.Exit" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.Help.About" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.System.NewProject" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.System.Refresh" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.System.CopyInfo" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.System.About" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
    <CommandBinding Command="Demo.System.ShowWindow" CanExecute="HandleCommandCanExecute" Executed="HandleCommandExecuted"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="Demo.File.Open" Gesture="Ctrl+O" CommandParameter="keyboard-open" CommandTarget="{x:Reference mainMenu}"/>
    <KeyBinding Command="Demo.System.Refresh" Key="F5" CommandParameter="keyboard-refresh"/>
    <KeyBinding Command="Demo.Help.About" Key="F1" CommandParameter="keyboard-help"/>
    <MouseBinding Command="Demo.System.Refresh" MouseAction="MiddleClick" Modifiers="Control" CommandParameter="mouse-refresh"/>
  </Window.InputBindings>
  <Window.DataContextSchema>
    <Property Path="TreeRoots" Kind="Object" ObjectType="BindingList" ItemType="DemoFolder" CanWrite="false"/>
    <Property Path="DemoListEntries" Kind="Object" ObjectType="BindingList" ItemType="DemoListEntry" CanWrite="false"/>
    <Property Path="WpfFirst" Kind="String"/>
    <Property Path="WpfLast" Kind="String"/>
    <Property Path="WpfPadded" Kind="String"/>
    <Property Path="WpfNullable" Kind="String"/>
    <Property Path="WpfMissing" Kind="String"/>
    <Property Path="WpfStatus" Kind="String"/>
    <Property Path="WpfIsAdmin" Kind="Bool"/>
    <Property Path="WpfPeople" Kind="Object" ObjectType="BindingList" ItemType="WpfLabPerson" CanWrite="false"/>
    <Property Path="WpfSettings" Kind="Object" ObjectType="BindingSource"/>
  </Window.DataContextSchema>
  <Grid x:Name="windowContent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Menu x:Name="mainMenu" DesignId="1" Grid.Row="0" Height="28">
      <Menu.Items>
        <MenuItem Header="文件">
          <MenuItem.Items>
            <MenuItem Header="打开" Command="Demo.File.Open" CommandParameter="menu-open" InputGestureText="Ctrl+O"/>
            <Separator/>
            <MenuItem Header="退出" Command="Demo.File.Exit" CommandParameter="menu-exit" InputGestureText="Alt+F4"/>
          </MenuItem.Items>
        </MenuItem>
        <MenuItem Header="帮助">
          <MenuItem.Items>
            <MenuItem Header="关于 XAML 模式" Command="Demo.Help.About" CommandParameter="menu-about" InputGestureText="F1"/>
          </MenuItem.Items>
        </MenuItem>
      </Menu.Items>
    </Menu>
    <ToolBar x:Name="mainToolBar" DesignId="2" Grid.Row="1" Height="40" ItemsPanel="{StaticResource MainToolBarItemsPanel}" Padding="6,7">
      <ToolBar.Items>
        <Button x:Name="toolBasic" DesignId="20" Height="26" Click="HandleToolBarAction" Content="基础" Width="88"/>
        <Button x:Name="toolData" DesignId="21" Height="26" Click="HandleToolBarAction" Content="数据" Width="88"/>
        <Button x:Name="toolAnalytics" DesignId="22" Height="26" Click="HandleToolBarAction" Content="可视化" Width="88"/>
        <Button x:Name="toolSystem" DesignId="23" Height="26" Click="HandleToolBarAction" Content="系统" Width="88"/>
        <Border x:Name="toolSeparator" DesignId="24" Margin="6,3" Background="{StaticResource Border}" Height="20" Width="1"/>
