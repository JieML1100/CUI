    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\build\VerifyCuiAotGenerated.ps1&quot; -GeneratedBase &quot;%(CuiCompile.OutputBase)&quot; -AllowKnownBlockers" />
  </Target>
  <Target Name="CuiVerifyTypedConverterBoundary" AfterTargets="CuiCompileGeneratedCode" BeforeTargets="ClCompile" Condition="'$(CuiCodeGenEnabled)'=='true'">
