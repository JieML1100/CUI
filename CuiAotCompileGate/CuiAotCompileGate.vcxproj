    <!--
      This include exists only for /p:CuiAotRequireRuntimeFree=false. It lets
      maintainers compile an intermediate generator output far enough to expose
      C++ lowering errors, without weakening the default production-only gate.
    -->
    <CuiAotDiagnosticInclude Condition="'$(CuiAotRequireRuntimeFree)'!='true'">$(ProjectDir)..\CuiRuntime\include;</CuiAotDiagnosticInclude>
