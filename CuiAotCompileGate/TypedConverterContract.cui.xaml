<Window xmlns="urn:cui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="TypedConverterContractWindow"
        Width="360"
        Height="180">
  <StackPanel x:Name="contractRoot">
    <TextBox x:Name="leftSource" Text="left"/>
    <TextBox x:Name="rightSource" Text="right"/>
    <TextBlock x:Name="singleResult"
               Text="{Binding Text, ElementName=leftSource, Mode=OneWay, Converter=AotFixture.Prefix}"/>
    <TextBlock x:Name="multiResult">
      <TextBlock.Text>
        <MultiBinding Mode="OneWay" Converter="AotFixture.Join">
          <Binding Path="Text" ElementName="leftSource"/>
          <Binding Path="Text" ElementName="rightSource"/>
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </StackPanel>
</Window>
