<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Keep C++ source and execution character sets independent of the Windows
       system locale or the Visual Studio UTF-8 preview setting. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
