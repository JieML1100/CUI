<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CuiRuntimeFlavor Condition="'$(CuiRuntimeFlavor)'==''">Production</CuiRuntimeFlavor>
    <CuiDynamicXamlEnabled Condition="'$(CuiRuntimeFlavor)'=='Design'">1</CuiDynamicXamlEnabled>
    <CuiDynamicXamlEnabled Condition="'$(CuiRuntimeFlavor)'!='Design'">0</CuiDynamicXamlEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)'=='CUI'">
    <!--
      Do not inherit the C++ defaults based on SolutionDir: direct project and
      solution builds otherwise publish the same flavor to different directories.
      Anchor both public libraries at the repository output root and give each
      flavor its own intermediates (including tlogs).
    -->
    <OutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\$(Platform)\$(Configuration)\'))</OutDir>
    <IntDir Condition="'$(CuiRuntimeFlavor)'=='Production'">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)\obj\$(Platform)\$(Configuration)\Production\'))</IntDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)'=='CUI' and '$(CuiRuntimeFlavor)'=='Design'">
    <TargetName>CUIDesignCore</TargetName>
    <IntDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)\obj\$(Platform)\$(Configuration)\Design\'))</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Keep the ABI flavor last so inherited property sheets cannot silently override it. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions);CUI_RUNTIME_FLAVOR_DESIGN=$(CuiDynamicXamlEnabled)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Visual Studio builds project references itself and asks MSBuild projects to
    resolve only GetTargetPath. That model cannot schedule both the Production
    and Design instances of CUI.vcxproj in the same solution configuration, so
    a Design consumer could link a stale CUIDesignCore.lib after CUI gained a
    new translation unit. Explicitly build the Design instance before reference
    resolution; command-line builds retain their normal project-reference path.
  -->
  <Target Name="CuiEnsureDesignCoreProjectReference"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(MSBuildProjectName)'!='CUI'
                  and '$(CuiRuntimeFlavor)'=='Design'
                  and '$(ConfigurationType)'=='Application'
                  and '$(DesignTimeBuild)'!='true'
                  and '$(BuildingInsideVisualStudio)'=='true'">
    <ItemGroup>
      <_CuiDesignCoreProjectReference
        Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)'=='CUI'" />
    </ItemGroup>
    <Message Condition="'@(_CuiDesignCoreProjectReference)'!=''"
             Importance="High"
             Text="CUI design-core dependency build: @(_CuiDesignCoreProjectReference->'%(FullPath)') ($(Configuration)|$(Platform))" />
    <MSBuild Condition="'@(_CuiDesignCoreProjectReference)'!=''"
             Projects="@(_CuiDesignCoreProjectReference)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);CuiRuntimeFlavor=Design"
             RemoveProperties="BuildingInsideVisualStudio;BuildingSolutionFile;BuildProjectReferences"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="ValidateCuiRuntimeFlavor" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(CuiRuntimeFlavor)'!='Production' and '$(CuiRuntimeFlavor)'!='Design'"
      Text="Unsupported CuiRuntimeFlavor '$(CuiRuntimeFlavor)'. Expected Production or Design." />
  </Target>
</Project>
