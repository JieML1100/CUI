<Window xmlns="urn:cui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="urn:cui:designer"
      x:Name="NamespacedRuntimeWindow"
      x:Class="Acme.Views.MainWindow"
      d:CodeBehind="NamespacedWindow"
      ContentRendered="HandleWindowContentRendered"
      Title="Acme::Views::MainWindow"
      Width="800" Height="600">
  <Window.CommandBindings>
    <CommandBinding Command="Demo.Static.Refresh"
                    CanExecute="HandleStaticRefreshCanExecute"
                    Executed="HandleStaticRefreshExecuted" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="Demo.Static.Refresh" Key="F5"
                CommandParameter="static-input"
                CommandTarget="{x:Reference namespaceButton}" />
  </Window.InputBindings>
  <Button x:Name="namespaceButton"
          DesignId="77"
		  Command="Demo.Static.Refresh"
		  CommandParameter="static-input"
		  CommandTarget="{x:Reference NamespacedRuntimeWindow}"
          Content="{Binding Caption}"
          Width="120" Height="24"
          AllowDrop="True"
		  Drop="HandleNamespacedDrop"
          Click="HandleNamespacedClick" />
</Window>
