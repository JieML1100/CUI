  <!--
    WPF ContentControl and ItemsControl do not paint fallback chrome in their
    native classes. Their default presentation is supplied by theme templates.
  -->
  <ControlTemplate
    x:Key="CuiContentControlTemplate"
    TargetType="ContentControl">
    <ContentPresenter
      x:Name="PART_ContentPresenter"
      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
      ContentSource="Content"/>
  </ControlTemplate>

  <Style TargetType="ContentControl">
    <Setter Property="Template"
      Value="{StaticResource CuiContentControlTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiItemsControlTemplate"
    TargetType="ItemsControl">
    <Border
      x:Name="PART_ItemsControlChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ItemsPresenter x:Name="PART_ItemsPresenter"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="ItemsControl">
    <Setter Property="Template"
      Value="{StaticResource CuiItemsControlTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiSeparatorTemplate"
    TargetType="Separator">
    <Border
      x:Name="PART_SeparatorRule"
      Width="{TemplateBinding Width}"
      Margin="{TemplateBinding Margin}"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"/>
  </ControlTemplate>

  <Style TargetType="Separator">
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiSeparatorBackground}"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="1,1,0,0"/>
    <Setter Property="Focusable" Value="false"/>
    <Setter Property="Template"
      Value="{StaticResource CuiSeparatorTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiGroupBoxTemplate"
    TargetType="GroupBox">
    <Border
      x:Name="PART_GroupBoxChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentControl
          Grid.Row="0"
          Margin="0,4,0,12"
          FontSize="20"
          Foreground="{StaticResource CuiGroupBoxHeaderForeground}">
          <ContentPresenter
            x:Name="PART_HeaderPresenter"
            ContentSource="Header"/>
        </ContentControl>
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          Grid.Row="1"
          Margin="{TemplateBinding Padding}"
          ContentSource="Content"/>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style TargetType="GroupBox">
    <Setter Property="Background"
      Value="{StaticResource CuiGroupBoxBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiGroupBoxBorder}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,0,0,16"/>
    <Setter Property="Template"
      Value="{StaticResource CuiGroupBoxTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiExpanderHeaderDownTemplate"
    TargetType="ToggleButton">
    <Grid x:Name="PART_HeaderRoot" Background="#00FFFFFF">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CheckStates">
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Chevron"
                Property="Text" Value="⌃"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unchecked"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderChrome"
                Property="BorderBrush"
                Value="{StaticResource CuiExpanderBorderPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderFocus"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_HeaderChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}">
        <Grid Margin="{TemplateBinding Padding}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter
            x:Name="PART_HeaderContent"
            Grid.Column="0"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Content"/>
          <TextBlock
            x:Name="PART_Chevron"
            Grid.Column="1"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{TemplateBinding Foreground}"
            Text="⌄"
            Visibility="Collapsed"/>
        </Grid>
      </Border>
      <Border
        x:Name="PART_HeaderFocus"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

