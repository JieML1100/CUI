  <!--
    ToggleButton is a public WPF control, not merely CheckBox/RadioButton's
    behavior base. The single appearance group represents WPF's compound
    IsChecked/IsMouseOver/IsPressed triggers without cross-group conflicts.
  -->
  <ControlTemplate
    x:Key="CuiToggleButtonTemplate"
    TargetType="ToggleButton">
    <Grid>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="AppearanceStates">
          <VisualState x:Name="DisabledChecked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundCheckedDisabled}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderCheckedDisabled}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundCheckedDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="DisabledUnchecked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
              <StateTrigger Property="IsChecked" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundDisabled}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderDisabled}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsPressed" Value="true"/>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundCheckedPressed}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderCheckedPressed}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundCheckedPressed}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="UncheckedPressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsPressed" Value="true"/>
              <StateTrigger Property="IsChecked" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundPressed}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderPressed}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundPressed}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CheckedPointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundCheckedPointerOver}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderChecked}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundChecked}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="UncheckedPointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
              <StateTrigger Property="IsChecked" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundPointerOver}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiButtonBorderPointerOver}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForeground}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackgroundChecked}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiToggleButtonBorderChecked}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForegroundChecked}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unchecked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackground}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiButtonBorder}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForeground}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Indeterminate">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleChrome" Property="Background"
                Value="{StaticResource CuiToggleButtonBackground}"/>
              <Setter TargetName="PART_ToggleChrome" Property="BorderBrush"
                Value="{StaticResource CuiButtonBorder}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleButtonForeground}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToggleFocusVisual"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_ToggleChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Padding="{TemplateBinding Padding}">
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
          ContentSource="Content"/>
      </Border>
      <Border
        x:Name="PART_ToggleFocusVisual"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ToggleButton">
    <Setter Property="Background"
      Value="{StaticResource CuiToggleButtonBackground}"/>
    <Setter Property="BorderBrush"
