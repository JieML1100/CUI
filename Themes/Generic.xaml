              <Setter TargetName="PART_HeaderChrome"
                Property="BorderBrush"
                Value="{StaticResource CuiExpanderBorderPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderFocus"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_HeaderChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}">
        <Grid Margin="{TemplateBinding Padding}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ContentPresenter
            x:Name="PART_HeaderContent"
            Grid.Row="0"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Content"/>
          <TextBlock
            x:Name="PART_Chevron"
            Grid.Row="1"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{TemplateBinding Foreground}"
            Text="‹"/>
        </Grid>
      </Border>
      <Border
        x:Name="PART_HeaderFocus"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <ControlTemplate
    x:Key="CuiExpanderHeaderRightTemplate"
    TargetType="ToggleButton">
    <Grid x:Name="PART_HeaderRoot" Background="#00FFFFFF">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CheckStates">
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Chevron"
                Property="Text" Value="‹"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unchecked"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderChrome"
                Property="BorderBrush"
                Value="{StaticResource CuiExpanderBorderPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderFocus"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_HeaderChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}">
        <Grid Margin="{TemplateBinding Padding}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ContentPresenter
            x:Name="PART_HeaderContent"
            Grid.Row="0"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Content"/>
          <TextBlock
            x:Name="PART_Chevron"
            Grid.Row="1"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{TemplateBinding Foreground}"
            Text="›"/>
        </Grid>
      </Border>
      <Border
        x:Name="PART_HeaderFocus"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <ControlTemplate
    x:Key="CuiExpanderTemplate"
    TargetType="Expander">
    <DockPanel x:Name="PART_ExpanderRoot">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="ExpansionStates">
          <VisualState x:Name="DownExpanded">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Down"/>
              <StateTrigger Property="IsExpanded" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Top"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE70E;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Bottom"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="BorderThickness" Value="1,0,1,1"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="CornerRadius" Value="0,0,4,4"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="DownCollapsed">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Down"/>
              <StateTrigger Property="IsExpanded" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Top"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE70D;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Bottom"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="UpExpanded">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Up"/>
              <StateTrigger Property="IsExpanded" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Bottom"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE70D;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Top"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="BorderThickness" Value="1,1,1,0"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="CornerRadius" Value="4,4,0,0"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="UpCollapsed">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Up"/>
              <StateTrigger Property="IsExpanded" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Bottom"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE70E;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Top"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="LeftExpanded">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Left"/>
              <StateTrigger Property="IsExpanded" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Right"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE76C;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Left"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="BorderThickness" Value="1,1,0,1"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="CornerRadius" Value="4,0,0,4"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="LeftCollapsed">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Left"/>
              <StateTrigger Property="IsExpanded" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Right"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE76B;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Left"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="RightExpanded">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Right"/>
              <StateTrigger Property="IsExpanded" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Left"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE76B;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Right"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="BorderThickness" Value="0,1,1,1"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="CornerRadius" Value="0,4,4,0"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="RightCollapsed">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Right"/>
              <StateTrigger Property="IsExpanded" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="DockPanel.Dock" Value="Left"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Text" Value="&#xE76C;"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="DockPanel.Dock" Value="Right"/>
              <Setter TargetName="PART_ContentPresenterBorder"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="ExpansionFallback"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="DirectionStates">
          <VisualState x:Name="DownHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Down"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Column" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Column" Value="1"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="UpHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Up"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Column" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Column" Value="1"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="LeftHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Left"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Column" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Row" Value="1"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Column" Value="0"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="RightHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="ExpandDirection" Value="Right"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Row" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Grid.Column" Value="0"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Row" Value="1"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Grid.Column" Value="0"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="DirectionFallback"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="HeaderSite"
                Property="Foreground"
                Value="{StaticResource CuiExpanderForegroundDisabled}"/>
              <Setter TargetName="PART_ExpansionGlyph"
                Property="Foreground"
                Value="{StaticResource CuiExpanderForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ToggleButton
        x:Name="HeaderSite"
        DockPanel.Dock="Top"
        Margin="0"
        Padding="{TemplateBinding Padding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Center"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        Foreground="{StaticResource CuiExpanderForeground}"
        Template="{StaticResource CuiExpanderHeaderDownTemplate}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ContentPresenter
            x:Name="PART_HeaderPresenter"
            Grid.Column="0"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Header"/>
          <TextBlock
            x:Name="PART_ExpansionGlyph"
            Grid.Column="1"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Segoe Fluent Icons"
            FontSize="12"
            Foreground="{StaticResource CuiExpanderForeground}"
            Text="&#xE70D;"/>
        </Grid>
      </ToggleButton>
      <Border
        x:Name="PART_ContentPresenterBorder"
        DockPanel.Dock="Bottom"
        Background="{StaticResource CuiExpanderContentBackground}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="1,0,1,1"
        CornerRadius="0,0,4,4"
        Visibility="Collapsed">
        <ContentPresenter
          x:Name="PART_ExpandSite"
          Margin="{TemplateBinding Padding}"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
          ContentSource="Content"/>
      </Border>
    </DockPanel>
  </ControlTemplate>

  <Style TargetType="Expander">
    <Setter Property="Background"
      Value="{StaticResource CuiExpanderBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiExpanderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="11"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="IsExpanded" Value="false"/>
    <Setter Property="Template"
      Value="{StaticResource CuiExpanderTemplate}"/>
  </Style>

  <ItemsPanelTemplate x:Key="CuiMenuItemsPanel">
    <StackPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="CuiMenuItemItemsPanel">
    <StackPanel Orientation="Vertical"/>
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="CuiContextMenuItemsPanel">
    <StackPanel Orientation="Vertical"/>
  </ItemsPanelTemplate>

  <ControlTemplate x:Key="CuiMenuTemplate" TargetType="Menu">
    <Border
      x:Name="PART_MenuChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <!-- The menu bar host must not add an independent clip: CUI's retained
           presentation tree has already arranged the top-level items inside
           this chrome, while a host-level clip can incorrectly crop their
           text (and transient popup descendants). -->
      <ItemsPresenter x:Name="PART_ItemsPresenter"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="Menu">
    <Setter Property="Background"
      Value="{StaticResource CuiMenuBarBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiMenuBorder}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiMenuItemForeground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="false"/>
    <Setter Property="IsTabStop" Value="false"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiMenuItemsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiMenuTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiMenuItemSeparatorTemplate"
    TargetType="Separator">
    <Border
      x:Name="PART_MenuSeparatorRule"
      Width="{TemplateBinding Width}"
      Margin="{TemplateBinding Margin}"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"/>
  </ControlTemplate>

  <!-- WPF MenuItem.SeparatorStyleKey, projected as a private keyed Style. -->
  <Style x:Key="CuiMenuItemSeparatorStyle" TargetType="Separator">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiMenuBorder}"/>
    <Setter Property="BorderThickness" Value="1,1,0,0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template"
      Value="{StaticResource CuiMenuItemSeparatorTemplate}"/>
  </Style>

  <!-- WPF Fluent uses one template per MenuItem.Role. -->
  <!--
    A menu bar commonly occupies a 28-DIP slot.  Keep the combined vertical
    chrome and content insets below that height: the previous 4-DIP Border
    margin plus 10-DIP DockPanel margin on both sides left its HeaderPresenter
    with a zero-height arrange slot, so top-level headers remained hit-testable
    but had no pixels to draw.
  -->
  <ControlTemplate
    x:Key="CuiMenuItemTopLevelHeaderTemplate"
    TargetType="MenuItem">
    <Grid x:Name="PART_MenuItemRoot">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Foreground"
                Value="{StaticResource CuiMenuItemForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Highlighted">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsHighlighted" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_MenuItemChrome"
                Property="Background"
                Value="{StaticResource CuiMenuItemPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="SubmenuStates">
          <VisualState x:Name="Opened">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsSubmenuOpen" Value="true"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Closed"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="IconStates">
          <VisualState x:Name="NoIcon">
            <VisualState.StateTriggers>
              <StateTrigger Property="Icon" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Icon"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="IconPresent"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="HeaderStates">
          <VisualState x:Name="NoHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="Header" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Icon"
                Property="Margin" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="HeaderPresent"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_MenuItemChrome"
        Margin="2"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="6">
        <DockPanel Margin="8,0">
          <ContentPresenter
            x:Name="PART_Icon"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Content="{TemplateBinding Icon}"/>
          <ContentPresenter
            x:Name="PART_HeaderPresenter"
            Margin="{TemplateBinding Padding}"
            VerticalAlignment="Center"
            ContentSource="Header"/>
        </DockPanel>
      </Border>
      <Popup
        x:Name="PART_Popup"
        HorizontalOffset="-12"
        VerticalOffset="1"
        Placement="Bottom"
        IsOpen="{TemplateBinding IsSubmenuOpen}"
        StaysOpen="false">
        <Border
          x:Name="PART_SubmenuBorder"
          MinWidth="140"
          Margin="12,0,12,18"
          Padding="0,3"
          Background="{StaticResource CuiMenuBackground}"
          BorderBrush="{StaticResource CuiMenuBorder}"
          BorderThickness="1"
          CornerRadius="8">
          <Border.RenderTransform>
            <TranslateTransform/>
          </Border.RenderTransform>
          <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsPresenter x:Name="PART_ItemsPresenter"
              ClipToBounds="true"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
  </ControlTemplate>

  <ControlTemplate
    x:Key="CuiMenuItemTopLevelItemTemplate"
    TargetType="MenuItem">
    <Border
      x:Name="PART_MenuItemChrome"
      Margin="2"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="6">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Foreground"
                Value="{StaticResource CuiMenuItemForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Highlighted">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsHighlighted" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Background"
                Value="{StaticResource CuiMenuItemPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="SubmenuStates">
          <VisualState x:Name="Opened">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsSubmenuOpen" Value="true"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Closed"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="IconStates">
          <VisualState x:Name="NoIcon">
            <VisualState.StateTriggers>
              <StateTrigger Property="Icon" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Icon"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="IconPresent"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="HeaderStates">
          <VisualState x:Name="NoHeader">
            <VisualState.StateTriggers>
              <StateTrigger Property="Header" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Icon"
                Property="Margin" Value="0"/>
              <Setter TargetName="PART_HeaderPresenter"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="HeaderPresent"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <DockPanel Margin="8,0">
        <ContentPresenter
          x:Name="PART_Icon"
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
