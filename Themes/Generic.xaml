    <Setter Property="BorderBrush"
      Value="{StaticResource CuiButtonBorder}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiButtonForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="11,5,11,6"/>
    <Setter Property="Template"
      Value="{StaticResource CuiButtonTemplate}"/>
  </Style>

  <ControlTemplate x:Key="CuiCheckBoxTemplate" TargetType="CheckBox">
    <Grid>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CheckStates">
          <VisualState x:Name="Indeterminate">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_UncheckedGlyph" Property="Visibility"
                Value="Collapsed"/>
              <Setter TargetName="PART_CheckGlyph" Property="Visibility"
                Value="Collapsed"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_UncheckedGlyph" Property="Visibility"
                Value="Collapsed"/>
              <Setter TargetName="PART_CheckGlyph" Property="Visibility"
                Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unchecked"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_UncheckedGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedDisabled}"/>
              <Setter TargetName="PART_UncheckedGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedDisabled}"/>
              <Setter TargetName="PART_CheckGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedDisabled}"/>
              <Setter TargetName="PART_CheckGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedDisabled}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedDisabled}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedDisabled}"/>
              <Setter TargetName="PART_CheckMark" Property="Background"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
              <Setter TargetName="PART_IndeterminateMark"
                Property="Background"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsPressed" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_UncheckedGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedPressed}"/>
              <Setter TargetName="PART_UncheckedGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPressed}"/>
              <Setter TargetName="PART_CheckGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_CheckGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_CheckMark" Property="Background"
                Value="{StaticResource CuiToggleGlyphPressed}"/>
              <Setter TargetName="PART_IndeterminateMark"
                Property="Background"
                Value="{StaticResource CuiToggleGlyphPressed}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_UncheckedGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedPointerOver}"/>
              <Setter TargetName="PART_UncheckedGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPointerOver}"/>
              <Setter TargetName="PART_CheckGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_CheckGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_IndeterminateGlyph"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_CheckBoxFocusVisual"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_CheckBoxRoot"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}">
        <StackPanel Orientation="Horizontal">
          <Grid Width="20" Height="20" VerticalAlignment="Center">
            <Border
              x:Name="PART_UncheckedGlyph"
              Width="20"
              Height="20"
              Background="{StaticResource CuiToggleFillUnchecked}"
              BorderBrush="{StaticResource CuiToggleStrokeUnchecked}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CuiControlCornerRadius}"/>
            <Border
              x:Name="PART_CheckGlyph"
              Width="20"
              Height="20"
              Background="{StaticResource CuiToggleFillChecked}"
              BorderBrush="{StaticResource CuiToggleFillChecked}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CuiControlCornerRadius}"
              Visibility="Collapsed">
              <Border
                x:Name="PART_CheckMark"
                Width="12"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CuiToggleGlyph}"
                Clip="{StaticResource CuiCheckMarkClip}"/>
            </Border>
            <Border
              x:Name="PART_IndeterminateGlyph"
              Width="20"
              Height="20"
              Background="{StaticResource CuiToggleFillChecked}"
              BorderBrush="{StaticResource CuiToggleFillChecked}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CuiControlCornerRadius}"
              Visibility="Collapsed">
              <Border
                x:Name="PART_IndeterminateMark"
                Width="10"
                Height="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CuiToggleGlyph}"
                CornerRadius="1"/>
            </Border>
          </Grid>
          <ContentPresenter
            x:Name="PART_CheckContent"
            Margin="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Content"/>
        </StackPanel>
      </Border>
      <Border
        x:Name="PART_CheckBoxFocusVisual"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="CheckBox">
    <Setter Property="Background"
      Value="#00FFFFFF"/>
    <Setter Property="BorderBrush"
      Value="#00FFFFFF"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiToggleForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Padding" Value="8,5,0,0"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template"
      Value="{StaticResource CuiCheckBoxTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiRadioButtonTemplate"
    TargetType="RadioButton">
    <Grid>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CheckStates">
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_RadioGlyph" Property="Visibility"
                Value="Collapsed"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="Visibility" Value="Visible"/>
              <Setter TargetName="PART_RadioCheckGlyph"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unchecked"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="0:0:0.250"/>
          </VisualStateGroup.Transitions>
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
              <Setter TargetName="PART_RadioGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedDisabled}"/>
              <Setter TargetName="PART_RadioGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedDisabled}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="Background"
                Value="{StaticResource CuiToggleFillCheckedDisabled}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsPressed" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_RadioGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedPressed}"/>
              <Setter TargetName="PART_RadioGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPressed}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPressed}"/>
              <Setter TargetName="PART_RadioCheckGlyph"
                Property="RenderTransform"
                Value="{StaticResource CuiRadioGlyphPressedTransform}"/>
              <Setter TargetName="PART_RadioPressedPreview"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_RadioGlyph" Property="Background"
                Value="{StaticResource CuiToggleFillUncheckedPointerOver}"/>
              <Setter TargetName="PART_RadioGlyph" Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPointerOver}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_RadioCheckedOuter"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_RadioCheckGlyph"
                Property="RenderTransform"
                Value="{StaticResource CuiRadioGlyphPointerOverTransform}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal">
            <VisualState.Setters>
              <Setter TargetName="PART_RadioCheckGlyph"
                Property="RenderTransform"
                Value="{StaticResource CuiRadioGlyphNormalTransform}"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_RadioFocusVisual"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_RadioRoot"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource CuiControlCornerRadius}">
        <StackPanel Orientation="Horizontal">
          <Grid Width="20" Height="32" VerticalAlignment="Top">
            <Border
              x:Name="PART_RadioGlyph"
              Width="20"
              Height="20"
              VerticalAlignment="Center"
              Background="{StaticResource CuiToggleFillUnchecked}"
              BorderBrush="{StaticResource CuiToggleStrokeUnchecked}"
              BorderThickness="1"
              CornerRadius="10"/>
            <Border
              x:Name="PART_RadioCheckedOuter"
              Width="20"
              Height="20"
              VerticalAlignment="Center"
              Background="{StaticResource CuiToggleFillChecked}"
              BorderBrush="{StaticResource CuiToggleFillChecked}"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="Collapsed"/>
            <Border
              x:Name="PART_RadioCheckGlyph"
              Width="12"
              Height="12"
              VerticalAlignment="Center"
              Background="{StaticResource CuiToggleGlyph}"
              BorderBrush="{StaticResource CuiCircleElevationBorder}"
              BorderThickness="1"
              CornerRadius="6"
              RenderTransformOrigin="0.5,0.5"
              Visibility="Collapsed"/>
            <Border
              x:Name="PART_RadioPressedPreview"
              Width="10"
              Height="10"
              VerticalAlignment="Center"
              Background="{StaticResource CuiToggleGlyph}"
              BorderBrush="{StaticResource CuiCircleElevationBorder}"
              BorderThickness="1"
              CornerRadius="5"
              Visibility="Collapsed"/>
          </Grid>
          <ContentPresenter
            x:Name="PART_RadioContent"
            Margin="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            ContentSource="Content"/>
        </StackPanel>
      </Border>
      <Border
        x:Name="PART_RadioFocusVisual"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="{DynamicResource CuiControlCornerRadius}"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="RadioButton">
    <Setter Property="Background" Value="#00FFFFFF"/>
    <Setter Property="BorderBrush" Value="#00FFFFFF"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiToggleForeground}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Padding" Value="8,6,0,0"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Template"
      Value="{StaticResource CuiRadioButtonTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiProgressBarTemplate"
    TargetType="ProgressBar">
    <Grid x:Name="PART_ProgressRoot">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="ProgressStates">
          <VisualState x:Name="IndeterminateVertical">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsIndeterminate" Value="true"/>
              <StateTrigger Property="Orientation" Value="Vertical"/>
              <StateTrigger Property="IsVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_DeterminateIndicator"
                Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_VerticalGlowRect"
                Property="Visibility" Value="Visible"/>
              <Setter TargetName="PART_TrackBorder"
                Property="Background"
                Value="{StaticResource CuiProgressIndeterminateBackground}"/>
              <Setter TargetName="PART_TrackBorder"
                Property="BorderBrush"
                Value="{StaticResource CuiProgressIndeterminateBorder}"/>
            </VisualState.Setters>
            <VisualState.Storyboard>
              <Storyboard>
                <PointAnimation
                  Storyboard.TargetName="PART_VerticalGlowRect"
                  Storyboard.TargetProperty="RenderTransformOrigin"
                  From="0.5,-0.5"
                  To="0.5,1.5"
                  Duration="0:0:0.9"
                  RepeatBehavior="Forever"/>
              </Storyboard>
            </VisualState.Storyboard>
          </VisualState>
          <VisualState x:Name="Indeterminate">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsIndeterminate" Value="true"/>
              <StateTrigger Property="Orientation" Value="Horizontal"/>
              <StateTrigger Property="IsVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_DeterminateIndicator"
                Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_GlowRect" Property="Visibility"
                Value="Visible"/>
              <Setter TargetName="PART_TrackBorder"
                Property="Background"
                Value="{StaticResource CuiProgressIndeterminateBackground}"/>
              <Setter TargetName="PART_TrackBorder"
                Property="BorderBrush"
                Value="{StaticResource CuiProgressIndeterminateBorder}"/>
            </VisualState.Setters>
            <VisualState.Storyboard>
              <Storyboard>
                <PointAnimation
                  Storyboard.TargetName="PART_GlowRect"
                  Storyboard.TargetProperty="RenderTransformOrigin"
                  From="-0.5,0.5"
                  To="1.5,0.5"
                  Duration="0:0:0.9"
                  RepeatBehavior="Forever"/>
              </Storyboard>
            </VisualState.Storyboard>
          </VisualState>
          <VisualState x:Name="Determinate"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="OrientationStates">
          <VisualState x:Name="Vertical">
            <VisualState.StateTriggers>
              <StateTrigger Property="Orientation" Value="Vertical"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Horizontal"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_TrackBorder"
        Margin="1"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"/>
      <Grid x:Name="PART_Track"/>
      <Grid
        x:Name="PART_Indicator"
        Margin="1"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch">
        <Border
          x:Name="PART_DeterminateIndicator"
          Background="{TemplateBinding Foreground}"
          CornerRadius="6"/>
        <Border
          x:Name="PART_GlowRect"
          Background="{TemplateBinding Foreground}"
          CornerRadius="6"
          RenderTransformOrigin="0.5,0.5"
          Visibility="Collapsed">
          <Border.RenderTransform>
            <ScaleTransform ScaleX="0.25"/>
          </Border.RenderTransform>
        </Border>
        <Border
          x:Name="PART_VerticalGlowRect"
          Background="{TemplateBinding Foreground}"
          CornerRadius="6"
          RenderTransformOrigin="0.5,0.5"
          Visibility="Collapsed">
          <Border.RenderTransform>
            <ScaleTransform ScaleY="0.25"/>
          </Border.RenderTransform>
        </Border>
      </Grid>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ProgressBar">
    <Setter Property="Background"
      Value="{StaticResource CuiProgressTrack}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiProgressIndicator}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiProgressBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"
      Value="{StaticResource CuiProgressBarTemplate}"/>
  </Style>

  <ControlTemplate x:Key="CuiSliderTemplate" TargetType="Slider">
    <Grid x:Name="PART_SliderRoot">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="OrientationStates">
          <VisualState x:Name="Vertical">
            <VisualState.StateTriggers>
              <StateTrigger Property="Orientation" Value="Vertical"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Horizontal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Pressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsThumbDragging" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ThumbInner"
                Property="RenderTransform"
                Value="{StaticResource CuiSliderThumbPressedTransform}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_TrackBackground"
                Property="Background"
                Value="{StaticResource CuiSliderTrack}"/>
              <Setter TargetName="PART_ThumbInner"
                Property="Background"
                Value="{StaticResource CuiSliderThumbPointerOver}"/>
              <Setter TargetName="PART_ThumbInner"
                Property="RenderTransform"
                Value="{StaticResource CuiSliderThumbPointerOverTransform}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="SelectionStates">
          <VisualState x:Name="SelectionRange">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsSelectionRangeEnabled"
                Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SelectionRange"
                Property="Visibility" Value="Visible"/>
              <Setter TargetName="PART_SelectedRange"
                Property="Visibility" Value="Collapsed"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="SelectedRange"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible"
                Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SliderFocusVisual"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Canvas x:Name="PART_Track" Cursor="Arrow">
        <Border
          x:Name="PART_TrackBackground"
          Background="{TemplateBinding Background}"
          BorderThickness="0"
          CornerRadius="2"/>
        <Border
          x:Name="PART_SelectionRange"
          Background="{TemplateBinding Foreground}"
          BorderThickness="0"
          CornerRadius="2"
          Visibility="Collapsed"/>
        <Border
          x:Name="PART_SelectedRange"
          Background="{TemplateBinding Foreground}"
          BorderThickness="0"
          CornerRadius="2"/>
        <Border
          x:Name="PART_Thumb"
          Width="20"
          Height="20"
          Background="{StaticResource CuiSliderOuterThumb}"
          BorderBrush="{StaticResource CuiCircleElevationBorder}"
          BorderThickness="1"
          CornerRadius="10">
          <Border
            x:Name="PART_ThumbInner"
            Width="12"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource CuiSliderThumb}"
            BorderThickness="0"
            CornerRadius="6"
            RenderTransformOrigin="0.5,0.5"
            RenderTransform="{StaticResource CuiSliderThumbNormalTransform}"/>
        </Border>
      </Canvas>
      <Border
        x:Name="PART_SliderFocusVisual"
        Margin="-3"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="4"
        Visibility="Collapsed"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="Slider">
    <Setter Property="Background"
      Value="{StaticResource CuiSliderTrack}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiSliderSelection}"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"
      Value="{StaticResource CuiSliderTemplate}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="MinHeight" Value="32"/>
      </Trigger>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="104"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    WPF ListBox overrides ItemsPanel metadata with VirtualizingStackPanel and
    its theme supplies ScrollViewer + ItemsPresenter. Keep both defaults in
    XAML here: large ItemsSource values must not synchronously instantiate
    every item before the first frame.
  -->
  <ItemsPanelTemplate x:Key="CuiListBoxItemsPanel">
    <VirtualizingStackPanel ItemHeight="40" CacheLength="1"/>
  </ItemsPanelTemplate>

  <ItemsPanelTemplate x:Key="CuiListViewItemsPanel">
    <VirtualizingStackPanel ItemHeight="40" CacheLength="1"/>
  </ItemsPanelTemplate>

  <ControlTemplate x:Key="CuiListBoxTemplate" TargetType="ListBox">
    <Border
      x:Name="PART_ListBoxChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
      </ScrollViewer>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="CuiListViewTemplate" TargetType="ListView">
    <Border
      x:Name="PART_ListViewChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <ItemsPresenter x:Name="PART_ItemsPresenter"/>
      </ScrollViewer>
    </Border>
  </ControlTemplate>

  <Style TargetType="ListBox">
    <Setter Property="Background"
      Value="{StaticResource CuiListBoxBackground}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiListBoxItemsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiListBoxTemplate}"/>
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background"
      Value="{StaticResource CuiListViewBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiListViewBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiListViewItemsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiListViewTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiListBoxItemTemplate"
    TargetType="ListBoxItem">
    <Border
      x:Name="PART_ItemChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}"
      CornerRadius="0">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="SelectionStates">
          <VisualState x:Name="Selected">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsSelected" Value="true"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Unselected"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <ControlTemplate
    x:Key="CuiListViewItemTemplate"
    TargetType="ListViewItem">
    <Border
      x:Name="PART_ItemChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="{DynamicResource CuiControlCornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="SelectionStates">
          <VisualState x:Name="Selected">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsSelected" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SelectionIndicator"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unselected"/>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid>
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          Margin="{TemplateBinding Padding}"
          ContentSource="Content"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        <Border
          x:Name="PART_SelectionIndicator"
          Width="3"
          Height="16"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="{StaticResource CuiListViewItemSelectionIndicator}"
          BorderThickness="0"
          CornerRadius="2"
          Visibility="Collapsed"/>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiListItemForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Template"
      Value="{StaticResource CuiListBoxItemTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiListItemSelected}"/>
        <Setter Property="Foreground"
          Value="{StaticResource CuiListItemForeground}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="false"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiListItemPointerOver}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="true"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiListItemSelectedPointerOver}"/>
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiListItemForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Padding" Value="16,0,12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiListViewItemTemplate}"/>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsEnabled" Value="true"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiListViewItemPointerOver}"/>
      </MultiTrigger>
      <Trigger Property="IsSelected" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiListViewItemPointerOver}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    DataGrid remains an ItemsControl/Selector pipeline: the theme owns the
    chrome and the two presenter slots, while DataGridRow composes real Grid
    and DataGridCell controls for every realized record.
  -->
  <ItemsPanelTemplate x:Key="CuiDataGridRowsPanel">
    <VirtualizingStackPanel ItemHeight="38" CacheLength="1"/>
  </ItemsPanelTemplate>

  <ControlTemplate
    x:Key="CuiDataGridSelectAllButtonTemplate"
    TargetType="Button">
    <Border
      x:Name="PART_SelectAllChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <Style x:Key="CuiDataGridSelectAllButtonStyle" TargetType="Button">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridHeaderBackground}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridHeaderForeground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Focusable" Value="false"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridSelectAllButtonTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPointerOver}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridTemplate"
    TargetType="DataGrid">
    <Border
      x:Name="PART_DataGridChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}"
      CornerRadius="{DynamicResource CuiControlCornerRadius}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
		<Grid
		  Grid.Row="0"
		  x:Name="PART_HeadersRow">
		  <Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		  </Grid.ColumnDefinitions>
		  <Button
			x:Name="PART_SelectAllButton"
			Grid.Column="0"
			Content="◢"
			AutomationProperties.Name="Select All"
			Style="{StaticResource CuiDataGridSelectAllButtonStyle}"/>
		  <Grid
			x:Name="PART_ColumnHeadersViewport"
			Grid.Column="1"
			ClipToBounds="true">
			<DataGridColumnHeadersPresenter
			  x:Name="PART_ColumnHeadersPresenter"/>
		  </Grid>
		</Grid>
        <ScrollViewer
          x:Name="PART_ScrollViewer"
          Grid.Row="1"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">
          <ItemsPresenter x:Name="PART_ItemsPresenter"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style TargetType="DataGrid">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiDataGridBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="RowHeight" Value="38"/>
    <Setter Property="ColumnHeaderHeight" Value="38"/>
    <Setter Property="RowBackground"
      Value="{StaticResource CuiDataGridRowBackground}"/>
    <Setter Property="AlternatingRowBackground"
      Value="{StaticResource CuiDataGridAlternatingRowBackground}"/>
    <Setter Property="HorizontalGridLinesBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="VerticalGridLinesBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiDataGridRowsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridTemplate}"/>
  </Style>

  <Style TargetType="DataGridColumnHeadersPresenter">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridHeaderBackground}"/>
    <Setter Property="MinHeight" Value="38"/>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridColumnHeaderTemplate"
    TargetType="DataGridColumnHeader">
    <Border
      x:Name="PART_ColumnHeaderChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridHeaderBackground}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridHeaderForeground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="10,0,8,0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridColumnHeaderTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPointerOver}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridRowHeaderTemplate"
    TargetType="DataGridRowHeader">
    <Border
      x:Name="PART_RowHeaderChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="DataGridRowHeader">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridHeaderBackground}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridHeaderForeground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridRowHeaderTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsRowSelected" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridRowSelected}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsRowSelected" Value="false"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPointerOver}"/>
      </MultiTrigger>
      <Trigger Property="IsPressed" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridHeaderPressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridRowTemplate"
    TargetType="DataGridRow">
    <Border
      x:Name="PART_RowChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="DataGridRow">
    <Setter Property="Background"
      Value="{StaticResource CuiDataGridRowBackground}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridCellForeground}"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridRowTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridRowSelected}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="false"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridRowPointerOver}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="true"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridRowSelectedPointerOver}"/>
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!--
    DataGrid columns create their display/editing elements in native code.
    Keep their default presentation separate from the standalone Label,
    TextBox and CheckBox styles: the cell owns spacing and focus chrome.
  -->
  <Style x:Key="CuiDataGridTextElementStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="2,0,2,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridTextEditingElementTemplate"
    TargetType="TextBox">
    <Border Background="{TemplateBinding Background}">
      <Grid x:Name="PART_ContentHost"/>
    </Border>
  </ControlTemplate>

  <Style x:Key="CuiDataGridTextEditingElementStyle"
    BasedOn="{StaticResource {x:Type TextBox}}"
    TargetType="TextBox">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridCellForeground}"/>
    <Setter Property="CaretBrush"
      Value="{StaticResource CuiDataGridCellForeground}"/>
    <Setter Property="SelectionBrush"
      Value="{StaticResource CuiTextControlSelection}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="SelectionTextBrush" Value="#FFFFFFFF"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridTextEditingElementTemplate}"/>
  </Style>

  <Style x:Key="CuiDataGridCheckBoxElementStyle"
    BasedOn="{StaticResource {x:Type CheckBox}}"
    TargetType="CheckBox">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <ControlTemplate
    x:Key="CuiDataGridCellTemplate"
    TargetType="DataGridCell">
    <Border
      x:Name="PART_CellChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiDataGridCellForeground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiDataGridGridLine}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"
      Value="{StaticResource CuiDataGridCellTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="true">
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridCellSelected}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="true"/>
          <Condition Property="IsMouseOver" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background"
          Value="{StaticResource CuiDataGridCellSelectedPointerOver}"/>
      </MultiTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="true">
        <Setter Property="BorderBrush"
          Value="{StaticResource CuiDataGridCurrentCellBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- WPF ToolBar applies type-specific keyed styles to known item types. -->
  <ControlTemplate
    x:Key="CuiToolBarButtonTemplate"
    TargetType="Button">
    <Grid>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ToolBarButtonChrome"
                Property="Background"
                Value="{StaticResource CuiButtonBackgroundPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_ToolBarButtonChrome"
        Padding="{TemplateBinding Padding}"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ContentSource="Content"/>
      </Border>
    </Grid>
  </ControlTemplate>

  <Style x:Key="CuiToolBarButtonStyle"
    BasedOn="{StaticResource {x:Type Button}}"
    TargetType="Button">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Template"
      Value="{StaticResource CuiToolBarButtonTemplate}"/>
  </Style>
  <Style x:Key="CuiToolBarToggleButtonStyle"
    BasedOn="{StaticResource {x:Type ToggleButton}}"
    TargetType="ToggleButton"/>
  <Style x:Key="CuiToolBarCheckBoxStyle"
    BasedOn="{StaticResource {x:Type CheckBox}}"
    TargetType="CheckBox"/>
  <Style x:Key="CuiToolBarRadioButtonStyle"
    BasedOn="{StaticResource {x:Type RadioButton}}"
    TargetType="RadioButton"/>
  <Style x:Key="CuiToolBarComboBoxStyle"
    BasedOn="{StaticResource {x:Type ComboBox}}"
    TargetType="ComboBox"/>
  <Style x:Key="CuiToolBarTextBoxStyle"
    BasedOn="{StaticResource {x:Type TextBox}}"
    TargetType="TextBox">
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style x:Key="CuiToolBarMenuStyle"
    BasedOn="{StaticResource {x:Type Menu}}"
    TargetType="Menu"/>
  <Style x:Key="CuiToolBarSeparatorStyle"
    BasedOn="{StaticResource {x:Type Separator}}"
    TargetType="Separator"/>

  <ItemsPanelTemplate x:Key="CuiToolBarItemsPanel">
    <StackPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>

  <ControlTemplate x:Key="CuiToolBarTemplate" TargetType="ToolBar">
    <Border
      x:Name="PART_ToolBarChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="4"
      Padding="{TemplateBinding Padding}">
      <ItemsPresenter x:Name="PART_ItemsPresenter"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="ToolBar">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiToolBarItemsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiToolBarTemplate}"/>
  </Style>

  <ItemsPanelTemplate x:Key="CuiStatusBarItemsPanel">
    <StackPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>

  <ControlTemplate x:Key="CuiStatusBarTemplate" TargetType="StatusBar">
    <Border
      x:Name="PART_StatusBarChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ItemsPresenter x:Name="PART_ItemsPresenter"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="StatusBar">
    <Setter Property="Background"
      Value="{StaticResource CuiButtonBackground}"/>
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiButtonBorder}"/>
    <Setter Property="Foreground"
      Value="{StaticResource CuiButtonForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="ItemsPanel"
      Value="{StaticResource CuiStatusBarItemsPanel}"/>
    <Setter Property="Template"
      Value="{StaticResource CuiStatusBarTemplate}"/>
  </Style>

  <Style x:Key="CuiStatusBarSeparatorStyle"
    TargetType="Separator">
    <Setter Property="BorderBrush"
      Value="{StaticResource CuiButtonBorder}"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="BorderThickness" Value="1,1,0,0"/>
    <Setter Property="Template"
      Value="{StaticResource CuiSeparatorTemplate}"/>
  </Style>

  <ControlTemplate
    x:Key="CuiStatusBarItemTemplate"
    TargetType="StatusBarItem">
    <Border
      x:Name="PART_StatusBarItemChrome"
      Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter
        x:Name="PART_ContentPresenter"
        ContentSource="Content"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
  </ControlTemplate>

  <Style TargetType="StatusBarItem">
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"
      Value="{StaticResource CuiStatusBarItemTemplate}"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="false">
        <Setter Property="Foreground"
          Value="{StaticResource CuiButtonForegroundDisabled}"/>
        <Setter Property="Background"
          Value="{StaticResource CuiButtonBackgroundDisabled}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
