  <ControlTemplate x:Key="CuiTabControlTemplate" TargetType="TabControl">
    <DockPanel x:Name="PART_TabControlRoot" LastChildFill="true">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="PlacementStates">
          <VisualState x:Name="Bottom">
            <VisualState.StateTriggers>
              <StateTrigger Property="TabStripPlacement" Value="Bottom"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ItemsPresenter"
                Property="DockPanel.Dock" Value="Bottom"/>
              <Setter TargetName="PART_ContentChrome"
                Property="CornerRadius" Value="4,4,4,0"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Left">
            <VisualState.StateTriggers>
              <StateTrigger Property="TabStripPlacement" Value="Left"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ItemsPresenter"
                Property="DockPanel.Dock" Value="Left"/>
              <Setter TargetName="PART_ContentChrome"
                Property="CornerRadius" Value="0,4,4,4"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Right">
            <VisualState.StateTriggers>
              <StateTrigger Property="TabStripPlacement" Value="Right"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_ItemsPresenter"
                Property="DockPanel.Dock" Value="Right"/>
              <Setter TargetName="PART_ContentChrome"
                Property="CornerRadius" Value="4,0,4,4"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Top">
            <VisualState.Setters>
              <Setter TargetName="PART_ItemsPresenter"
                Property="DockPanel.Dock" Value="Top"/>
              <Setter TargetName="PART_ContentChrome"
                Property="CornerRadius" Value="0,4,4,4"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ItemsPresenter
        x:Name="PART_ItemsPresenter"
        DockPanel.Dock="Top"/>
      <Border
        x:Name="PART_ContentChrome"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="0,4,4,4"
        ClipToBounds="true">
        <ContentPresenter
          x:Name="PART_SelectedContentHost"
          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
          ClipToBounds="true"
          Content="{TemplateBinding SelectedContent}"
          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
      </Border>
    </DockPanel>
  </ControlTemplate>

