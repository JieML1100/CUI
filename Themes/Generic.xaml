  <!--
    Switch is a CUI extension (desktop WPF has no Switch control). It keeps
    ToggleButton's WPF behavior while using Fluent toggle-switch geometry.
  -->
  <ControlTemplate x:Key="CuiSwitchTemplate" TargetType="Switch">
    <Canvas x:Name="PART_SwitchRoot">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CheckStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="0:0:0.100"/>
          </VisualStateGroup.Transitions>
            <VisualState x:Name="Indeterminate">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="{x:Null}"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Track" Property="Background"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
              <Setter TargetName="PART_Track" Property="BorderBrush"
                Value="{StaticResource CuiToggleFillCheckedPointerOver}"/>
            </VisualState.Setters>
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="PART_Thumb"
                  Storyboard.TargetProperty="(Control.RenderTransform).(TranslateTransform.X)"
                  To="10" Duration="0:0:0.100"/>
              </Storyboard>
            </VisualState.Storyboard>
          </VisualState>
          <VisualState x:Name="Checked">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsChecked" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_Track" Property="Background"
                Value="{StaticResource CuiToggleFillChecked}"/>
              <Setter TargetName="PART_Track" Property="BorderBrush"
                Value="{StaticResource CuiToggleFillChecked}"/>
            </VisualState.Setters>
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="PART_Thumb"
                  Storyboard.TargetProperty="(Control.RenderTransform).(TranslateTransform.X)"
                  To="20" Duration="0:0:0.100"/>
              </Storyboard>
            </VisualState.Storyboard>
          </VisualState>
          <VisualState x:Name="Unchecked">
            <VisualState.Storyboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="PART_Thumb"
                  Storyboard.TargetProperty="(Control.RenderTransform).(TranslateTransform.X)"
                  To="0" Duration="0:0:0.100"/>
              </Storyboard>
            </VisualState.Storyboard>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Disabled">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsEnabled" Value="false"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="Background" Value="#B3FFFFFF"/>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedDisabled}"/>
              <Setter TargetName="PART_Thumb" Property="Background"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
              <Setter Property="Foreground"
                Value="{StaticResource CuiToggleForegroundDisabled}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsPressed" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="Background" Value="#1A000000"/>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPressed}"/>
              <Setter TargetName="PART_Thumb" Property="Background"
                Value="{StaticResource CuiToggleGlyphPressed}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsMouseOver" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="Background" Value="#1AFFFFFF"/>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="BorderBrush"
                Value="{StaticResource CuiToggleStrokeUncheckedPointerOver}"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Normal">
            <VisualState.Setters>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="Background" Value="#00FFFFFF"/>
              <Setter TargetName="PART_SwitchInteractionBorder"
                Property="BorderBrush" Value="#00FFFFFF"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.StateTriggers>
              <StateTrigger Property="IsKeyboardFocusVisible" Value="true"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter TargetName="PART_SwitchFocusVisual"
                Property="Visibility" Value="Visible"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border
        x:Name="PART_Track"
        Width="40"
        Height="20"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="10"/>
      <Border
        x:Name="PART_SwitchInteractionBorder"
        Width="40"
        Height="20"
        Background="#00FFFFFF"
        BorderBrush="#00FFFFFF"
        BorderThickness="1"
        CornerRadius="10"/>
      <Border
        x:Name="PART_Thumb"
        Canvas.Left="2"
        Canvas.Top="2"
        Width="16"
        Height="16"
        Background="{StaticResource CuiSwitchThumb}"
        BorderBrush="{StaticResource CuiCircleElevationBorder}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
      </Border>
      <Border
        x:Name="PART_SwitchFocusVisual"
        Canvas.Left="-3"
        Canvas.Top="-3"
        Width="46"
        Height="26"
        BorderBrush="{StaticResource CuiKeyboardFocusBorder}"
        BorderThickness="2"
        CornerRadius="13"
        Visibility="Collapsed"/>
    </Canvas>
  </ControlTemplate>

